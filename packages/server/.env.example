# MongoDB 连接地址
MONGO_URI=mongodb://127.0.0.1:27017/webstore

# 支付回调基础地址：网关支付成功后回调本服务的公网地址
PAYMENT_NOTIFY_BASE_URL=http://localhost:3000

# 前端基础地址：跳转类支付付款后浏览器同步跳回此站点的商品页
WEB_BASE_URL=http://localhost:5173

# 日志输出等级，逗号分隔，可选值：fatal,error,warn,log,debug,verbose
LOG_LEVEL=log,error,warn

# API Key 签名密钥的加密主密钥：用于 AES-256-GCM 加/解密库中存储的 secret
# 任意长度随机字符串即可（内部经 sha256 派生为 32 字节）；务必保密且勿轻易更换
# 一旦更换，历史 API Key 的 secret 将无法解密，需要重新创建
APIKEY_SIGNING_SECRET=please-change-to-a-long-random-string

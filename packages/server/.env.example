# MongoDB 连接地址
MONGO_URI=mongodb://127.0.0.1:27017/webstore

# 支付回调基础地址：网关支付成功后回调本服务的公网地址
PAYMENT_NOTIFY_BASE_URL=http://localhost:3000

# 前端基础地址：跳转类支付付款后浏览器同步跳回此站点的商品页
WEB_BASE_URL=http://localhost:5173

# 日志输出等级，逗号分隔，可选值：fatal,error,warn,log,debug,verbose
LOG_LEVEL=log,error,warn

# JWT 签名密钥（登录令牌签发/校验），生产环境务必改为高熵随机值并保密
JWT_SECRET=change-me-to-a-long-random-secret
# JWT 有效期（zeit/ms 格式，如 7d / 12h / 3600s）
JWT_EXPIRES_IN=7d

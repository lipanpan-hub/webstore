{
  "name": "@webstore/ws-cli",
  "description": "a cli for webstore",
  "version": "0.0.0",
  "author": "lppx",
  "bin": {
    "wsc": "./bin/run.js"
  },
  "bugs": "https://github.com/lipanpan-hub/webstore/issues",
  "dependencies": {
    "@earendil-works/pi-tui": "^0.85.1",
    "@inquirer/prompts": "^8.7.2",
    "@oclif/core": "^4",
    "@oclif/plugin-autocomplete": "^4.0.0",
    "@oclif/plugin-help": "^6",
    "@oclif/plugin-not-found": "^4.0.0",
    "@oclif/plugin-version": "^3.0.1",
    "@oclif/plugin-warn-if-update-available": "^4.0.0",
    "fuse.js": "^7.5.0",
    "pino": "^10.3.1",
    "pino-mongodb": "^5.0.0",
    "pino-pretty": "^13.1.3",
    "pino-roll": "^4.0.0",
    "prompts": "^2.4.2",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@eslint/compat": "^1",
    "@oclif/prettier-config": "^0.2.1",
    "@oclif/test": "^4",
    "@types/chai": "^4",
    "@types/mocha": "^10",
    "@types/node": "^18",
    "@types/prompts": "^2.4.9",
    "chai": "^4",
    "eslint": "^9",
    "eslint-config-oclif": "^6",
    "eslint-config-prettier": "^10",
    "mocha": "^11",
    "oclif": "^4",
    "shx": "^0.3.3",
    "ts-node": "^10",
    "typescript": "^5"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "files": [
    "./bin",
    "./dist",
    "./oclif.manifest.json"
  ],
  "homepage": "https://github.com/lipanpan-hub/webstore",
  "keywords": [
    "oclif"
  ],
  "license": "BSL",
  "main": "dist/index.js",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "oclif": {
    "bin": "wsc",
    "dirname": "ws-cli",
    "commands": "./dist/commands",
    "plugins": [
      "@oclif/plugin-help",
      "@oclif/plugin-warn-if-update-available",
      "@oclif/plugin-autocomplete",
      "@oclif/plugin-not-found",
      "@oclif/plugin-version"
    ],
    "nsisCustomization": "nsis/nsis.nsi",
    "hooks": {
      "init": "./dist/hooks/init/inithook"
    },
    "topicSeparator": " ",
    "topics": {
      "hello": {
        "description": "Say hello to the world and others"
      }
    }
  },
  "repository": "lipanpan-hub/webstore",
  "scripts": {
    "build": "shx rm -rf dist && tsc -b",
    "lint": "eslint",
    "postpack": "shx rm -f oclif.manifest.json",
    "posttest": "npm run lint",
    "prepack": "oclif manifest && oclif readme",
    "test": "mocha --forbid-only \"test/**/*.test.ts\"",
    "version": "oclif readme && git add README.md",
    "dev": "node --loader ts-node/esm --no-warnings=ExperimentalWarning ./bin/dev.js",
    "start": "node ./bin/run.js",
    "pack:tarballs": "oclif pack tarballs",
    "pack:win": "oclif pack win",
    "pack:macos": "oclif pack macos",
    "pack:deb": "oclif pack deb"
  },
  "types": "dist/index.d.ts"
}
